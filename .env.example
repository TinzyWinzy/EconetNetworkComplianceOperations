# Server — Vercel env vars
DATABASE_URL=postgresql://USER:PASSWORD@host.neon.tech/neondb?sslmode=require
# PII_SECRET_SALT must match the salt used by db/seed-subscribers.mjs so that
# seeded subscriber lookups resolve. Demo value: econet-demo-salt-2026
PII_SECRET_SALT=econet-demo-salt-2026
FUP_LIMIT_GB=100
# Client — Vite (public, non-secret)
VITE_FUP_LIMIT_GB=100
VITE_API_BASE=
# Demo gate PIN (public, non-secret — demo gate is not real auth)
VITE_DEMO_PIN=1212
# Pilot hardening (default off for demo; set true in pilot/prod)
# REQUIRE_JWT=true enforces Bearer JWT on /api/telemetry
# STRICT_ZERO_PII=true rejects raw msisdn on /api/billing (hashedMsisdn only)
REQUIRE_JWT=false
STRICT_ZERO_PII=false
